# Values are supplied through the process environment; this file is not loaded automatically.
# Leave DOCWRIGHT_DB_PATH empty to use the local db.sqlite file.
DOCWRIGHT_DB_PATH=
# Set a unique local value before the first seed; never commit the actual value.
DOCWRIGHT_DEMO_PASSWORD=
# Optional directory for HTTP test scratch files.
DOCWRIGHT_TEST_BASE=
# Optional PHP executable for the HTTP test; defaults to php on PATH.
DOCWRIGHT_PHP=
